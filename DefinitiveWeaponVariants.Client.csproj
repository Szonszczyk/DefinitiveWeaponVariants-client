<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>DefinitiveWeaponVariants.Client</RootNamespace>
    <AssemblyName>DefinitiveWeaponVariants.Client</AssemblyName>
    <Nullable>disable</Nullable>
    <Authors>Szonszczyk</Authors>
    <Copyright>
    </Copyright>
    <AssemblyVersion>1.0.16</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Configurations>Debug;Release;Package</Configurations>
    <Version>$(AssemblyVersion)</Version>
    <LangVersion>latest</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <SptRoot Condition="'$(SptRoot)' == ''">C:\Games\SPT 4.1 - DEV</SptRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);reference\**</DefaultItemExcludes>
    <DeployToSpt Condition="'$(DeployToSpt)' == ''">true</DeployToSpt>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AnimationSystem.Types">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\AnimationSystem.Types.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhysicsModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-reflection.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Comfort.Unity, Version=1.0.0.4, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Comfort.Unity.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization, Version=1.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI, Version=1.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Content Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" GeneratePathProperty="true" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <None Include="$(PkgSoundTouch_Net)\LICENSE\LICENSE" Link="SoundTouch.Net.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="licenses\AssetsTools.NET.LICENSE.txt" Link="AssetsTools.NET.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- One manifest for both local deployment and the DWV server's distribution ZIP. -->
  <Target Name="CollectClientDistributionFiles" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <ClientDistributionFiles Include="$(TargetPath);@(ReferenceCopyLocalPaths);$(TargetDir)SoundTouch.Net.LICENSE.txt;$(TargetDir)AssetsTools.NET.LICENSE.txt;$(TargetDir)LICENSE.txt" />
    </ItemGroup>
    <Error Condition="!Exists('%(ClientDistributionFiles.Identity)')" Text="Missing DWV client distribution file: %(ClientDistributionFiles.Identity)" />
  </Target>
  <Target Name="GetClientDistributionFiles" DependsOnTargets="Build;CollectClientDistributionFiles" Returns="@(ClientDistributionFiles)" />
  <Target Name="DeployPluginToSpt" AfterTargets="Build" DependsOnTargets="CollectClientDistributionFiles" Condition="'$(DeployToSpt)' == 'true'">
    <Error Condition="!Exists('$(SptRoot)\BepInEx\plugins')" Text="SptRoot must point to an SPT installation containing BepInEx\plugins." />
    <Copy SourceFiles="@(ClientDistributionFiles)" DestinationFolder="$(SptRoot)\BepInEx\plugins\DefinitiveWeaponVariants" SkipUnchangedFiles="true" />
    <!-- Migrate the old flat installation only after the new files copy successfully.
         Leaving the old plugin DLL would register the same BepInEx GUID twice. -->
    <Delete Files="$(SptRoot)\BepInEx\plugins\$(TargetFileName);$(SptRoot)\BepInEx\plugins\$(TargetName).pdb" />
  </Target>
</Project>
